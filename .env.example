# Web
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API
HISAB_ENV=development
HISAB_DATABASE_URL=sqlite+aiosqlite:///./hisab.db
HISAB_CORS_ORIGINS=http://localhost:5173
HISAB_DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase deployment (leave empty for local demo mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# Optional open-weight assistant. Keep provider keys server-side.
# groq: hosted Qwen3.6-27B; ollama: local Qwen3 4B; disabled: deterministic fallback.
HISAB_LLM_PROVIDER=disabled
HISAB_GROQ_API_KEY=
HISAB_GROQ_MODEL=qwen/qwen3.6-27b
HISAB_OLLAMA_BASE_URL=http://127.0.0.1:11434
HISAB_OLLAMA_MODEL=qwen3:4b-instruct
HISAB_OLLAMA_FALLBACK=false
