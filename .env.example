# Web
VITE_API_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API
ARTHA_ENV=development
ARTHA_DATABASE_URL=sqlite+aiosqlite:///./artha.db
ARTHA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ARTHA_DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase deployment (leave empty for local demo mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# Optional financial assistant. Keep provider keys server-side.
# Gemini free-tier content may be used to improve Google's products. Use fictional eval data
# only on the free tier; use paid Gemini or local Ollama for real financial messages.
ARTHA_LLM_PROVIDER=disabled
ARTHA_GEMINI_API_KEY=
ARTHA_GEMINI_MODEL=gemini-3.5-flash-lite
ARTHA_GROQ_API_KEY=
ARTHA_GROQ_MODEL=openai/gpt-oss-20b
ARTHA_OLLAMA_BASE_URL=http://127.0.0.1:11434
ARTHA_OLLAMA_MODEL=qwen3:4b-instruct
ARTHA_OLLAMA_FALLBACK=false
